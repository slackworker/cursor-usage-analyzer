{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Init Project Environment",
      "type": "shell",
      "linux": {
        "command": "bash",
        "args": ["${workspaceFolder}/scripts/init.sh"]
      },
      "windows": {
        "command": "powershell",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "${workspaceFolder}/scripts/init.ps1"
        ]
      },
      "osx": {
        "command": "bash",
        "args": ["${workspaceFolder}/scripts/init.sh"]
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true,
        "clear": true
      },
      "problemMatcher": []
    }
  ]
}
