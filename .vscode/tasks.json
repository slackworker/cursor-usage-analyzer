{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Init Project Environment",
      "type": "shell",
      "linux": {
        "command": "bash",
        "args": ["${workspaceFolder}/scripts/init.sh"]
      },
      "windows": {
        "command": "powershell",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "${workspaceFolder}/scripts/init.ps1"
        ]
      },
      "osx": {
        "command": "bash",
        "args": ["${workspaceFolder}/scripts/init.sh"]
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true,
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Web: Dev Server",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/web"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite",
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "(Local:|ready in|VITE v)"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": false,
        "clear": false
      },
      "group": "none"
    }
  ]
}
